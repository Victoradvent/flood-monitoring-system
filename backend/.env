# MQTT Configuration
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USER=mosquitto
MQTT_PASS=mosquitto
MQTT_TOPIC=flood/+/data

# PostgreSQL Configuration
PG_HOST=localhost
PG_PORT=5432
PG_USER=flood_user
PG_PASS=flood_password
PG_DB=flood_monitoring

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production

# Server Port
PORT=5000

# Alert Cooldown (seconds)
ALERT_COOLDOWN_SEC=900

# Twilio Configuration (Optional - leave blank if not using SMS alerts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# SMS Gateway Configuration (Optional alternative to Twilio)
SMS_GATEWAY_URL=
SMS_GATEWAY_APIKEY=
SMS_GATEWAY_FROM=
