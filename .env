# PostgreSQL - Use same values for both POSTGRES_* and PG_* for consistency
POSTGRES_USER=admin
POSTGRES_PASSWORD=strongpassword
POSTGRES_DB=flooddb
JWT_SECRET=supersecret

# PostgreSQL individual connection params (for app.js)
PG_HOST=localhost
PG_PORT=5432
PG_USER=admin
PG_PASS=strongpassword
PG_DB=flooddb

# Alternatively, use DATABASE_URL (takes precedence if set)
# DATABASE_URL=postgres://admin:strongpassword@localhost:5432/flooddb

# MQTT Configuration
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USER=mqtt_user
MQTT_PASS=mqtt_password
MQTT_TOPIC=nodes/flood

# SMS Gateway Configuration (Twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM=+1234567890

# SMS Gateway (Alternative - HTTP-based)
SMS_GATEWAY_URL=https://sms-gateway.example/send
SMS_GATEWAY_APIKEY=apikey_here
SMS_GATEWAY_FROM=FLOODNODE

# Application Configuration
NODE_ID_PREFIX=NODE
ALERT_COOLDOWN_SEC=900
PORT=3000

# Frontend MQTT Configuration (React)
REACT_APP_MQTT_WS_URL=ws://localhost:9001
REACT_APP_MQTT_TOPIC=nodes/flood
REACT_APP_MQTT_USER=
REACT_APP_MQTT_PASS=

# WebSocket Configuration (Backend → Frontend)
BACKEND_WS_URL=ws://localhost:3000
