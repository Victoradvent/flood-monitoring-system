POSTGRES_USER=flood_app
POSTGRES_PASSWORD=REPLACE_WITH_A_UNIQUE_SECRET
POSTGRES_DB=flood_monitoring

JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

MQTT_USER=mqtt_backend
MQTT_PASS=REPLACE_WITH_A_UNIQUE_SECRET
MQTT_SIM_USER=sim_user
MQTT_SIM_PASS=REPLACE_WITH_A_DIFFERENT_UNIQUE_SECRET
MQTT_TLS=true

WARNING_LEVEL_CM=30
CRITICAL_LEVEL_CM=50
READING_STALE_AFTER_SEC=30

SMS_PROVIDER=simulated
SMS_SIM_FAILURE_RATE=0.2
SMS_SIM_RATE_LIMIT=10
SMS_SIM_MIN_DELAY_MS=100
SMS_SIM_MAX_DELAY_MS=500
SMS_SIM_SEED=fms-sms
