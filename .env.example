# Flood Monitoring System - Environment Variables Template
# Copy this to .env or .env.production and fill in your values

# ============================================
# DATABASE CONFIGURATION
# ============================================

# For local development (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flood_monitoring

# For production (DigitalOcean Managed Database)
# DATABASE_URL=postgresql://doadmin:PASSWORD@xxxxx.db.ondigitalocean.com:25060/defaultdb?sslmode=require

# Database connection details (if not using DATABASE_URL)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASS=postgres
PG_DB=flood_monitoring
PGSSLMODE=disable

# PostgreSQL setup (used by Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=flood_monitoring

# ============================================
# MQTT CONFIGURATION
# ============================================

# MQTT Broker
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USER=flood_user
MQTT_PASS=flood_password_secure

# MQTT Topic to subscribe to sensor readings
MQTT_TOPIC=nodes/flood

# ============================================
# AUTHENTICATION & SECURITY
# ============================================

# JWT Secret Key (generate with: openssl rand -base64 32)
JWT_SECRET=your_super_secret_jwt_key_here_generate_with_openssl

# Node environment
NODE_ENV=development

# ============================================
# SMS & ALERTS
# ============================================

# Twilio SMS Gateway
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM=+1234567890

# Alternative SMS Gateway (HTTP-based)
SMS_GATEWAY_URL=https://api.smsgw.com/send
SMS_GATEWAY_APIKEY=your_gateway_api_key
SMS_GATEWAY_FROM=YourCompanyName

# Alert cooldown in seconds (avoid alert spam)
ALERT_COOLDOWN_SEC=900

# ============================================
# SERVER CONFIGURATION
# ============================================

# Server port
PORT=3000

# Server host (0.0.0.0 for Docker/production)
HOST=0.0.0.0

# ============================================
# OPTIONAL: GIS/MAPPING
# ============================================

# PostGIS is required for location-based queries
# Make sure PostgreSQL extension is installed:
# CREATE EXTENSION IF NOT EXISTS postgis;

# ============================================
# OPTIONAL: OBSERVABILITY
# ============================================

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Sentry error tracking (optional)
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# ============================================
# FRONTEND CONFIGURATION
# ============================================

# Backend API URL for React frontend (optional, uses window.location by default)
REACT_APP_API_URL=http://localhost:3000

# Map center coordinates (default to global view)
REACT_APP_MAP_CENTER_LAT=0
REACT_APP_MAP_CENTER_LNG=0
REACT_APP_MAP_ZOOM=2

# ============================================
# NOTES
# ============================================

# For local development, use docker-compose up
# For production, see DEPLOYMENT.md

# Generate secure passwords:
# openssl rand -base64 32

# Test environment variables:
# docker-compose config (will show resolved values)
